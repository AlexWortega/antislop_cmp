# Second sshd on the GPU, reachable only through the reverse tunnel. Vast's own sshd takes account
# keys only, so this one reads the agent host's key from a file we control.
Port 2223
ListenAddress 127.0.0.1
HostKey /workspace/native/agent_sshd_host_key
AuthorizedKeysFile /workspace/native/agent_authorized_keys
PermitRootLogin prohibit-password
PasswordAuthentication no
KbdInteractiveAuthentication no
StrictModes no
AllowTcpForwarding yes
PidFile /workspace/native/agent_sshd.pid
