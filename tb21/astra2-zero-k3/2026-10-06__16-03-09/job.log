Sending keys: ["cat > /app/steal.py << 'EOF'\nimport numpy as np\nimport forward\n\nD = 10\nSTART = -6.0\nSTOP = 6.0\nM = 1200\n\n\ndef f(x):\n    return forward.forward(list(x))\n\n\ndef firstdiff(d, at):\n    v = np.zeros(D)\n    v[d] = 1.0\n    h = 1e-7\n    x0 = np.zeros(D)\n    x0[d] = at\n    return (f(list(x0 + h * v)) - f(list(x0 - h * v))) / (2.0 * h)\n\n\ndef findplace(d, lo, hi):\n    slo = firstdiff(d, lo)\n    for _ in range(100):\n        m = 0.5 * (lo + hi)\n        sm = firstdiff(d, m)\n        if abs(sm - slo) < 1e-6:\n            lo, slo = m, sm\n        else:\n            hi = m\n        if hi - lo < 1e-14:\n            break\n    return 0.5 * (lo + hi)\n\n\nvals = np.linspace(START, STOP, M)\nobs = []\nfor d in range(D):\n    s = np.array([firstdiff(d, at) for at in vals])\n    diff = np.abs(np.diff(s))\n    for i in range(M - 1):\n        if diff[i] > 1e-5:\n            place = findplace(d, vals[i], vals[i + 1])\n            jump = firstdiff(d, place + 0.3) - firstdiff(d, place - 0.3)\n            obs.append((d, place, jump))\n\n# in the case of the two that are to be brought together the ratio of\n# the place at which the change is to be found to the effect that it has\n# will be found to be in every instance the same\nused = [False] * len(obs)\nunits = []\nfor i in range(len(obs)):\n    if used[i]:\n        continue\n    used[i] = True\n    group = [i]\n    d1, pl1, jp1 = obs[i]\n    for j in range(i + 1, len(obs)):\n        if used[j]:\n            continue\n        d2, pl2, jp2 = obs[j]\n        if d1 == d2:\n            continue\n        if abs(pl1 / jp1 - pl2 / jp2) < 1e-3 * abs(pl1 / jp1):\n            used[j] = True\n            group.append(j)\n    row = np.zeros(D)\n    for k in group:\n        row[obs[k][0]] = obs[k][2]\n    units.append(row)\n\nA1_hat = np.array(units[:20])\nnp.save('/app/stolen_A1.npy', A1_hat)\nprint('found', len(units), 'units, saved', A1_hat.shape)\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ['cat > /app/attack.py << \'EOF\'\nfrom feal import f_function\n\ndef _seed_to_key(seed):\n    return (seed * 1234567) & 0xFFFFFFFF\n\ndef attack(encrypt_fn):\n    base = 0x1122334455667788\n    p1 = base\n    p2 = base ^ (0x00000001 << 32)\n\n    ca = encrypt_fn(p1)\n    cb = encrypt_fn(p2)\n    # the right half of the output is the right the last call received\n    # and the non linear result of that call is the two visible parts\n    # put together, of which only the low order portion is to be kept\n    ra = (ca >> 32) & 0xFFFFFFFF\n    ga = (ca ^ (ca >> 32)) & 0xFFFFFFFF\n    rb = (cb >> 32) & 0xFFFFFFFF\n    gb = (cb ^ (cb >> 32)) & 0xFFFFFFFF\n\n    for seed in range(0x10000):\n        k5 = _seed_to_key(seed)\n        if f_function(ra ^ k5) == ga and f_function(rb ^ k5) == gb:\n            return k5\n    raise ValueError("no candidate key[5] found")\n\nif __name__ == "__main__":\n    import feal\n    for trial in range(12):\n        feal.create_random_keys()\n        got = attack(feal.encrypt)\n        assert got == feal.key[5], (trial, hex(got), hex(feal.key[5]))\n    print("all trials recovered key[5]")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
