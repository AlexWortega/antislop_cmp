Sending keys: ["cat > /app/classify.py << 'EOF'\nfrom PIL import Image\nim = Image.open('chess_board.png').convert('RGB')\ns = 80\n\ndef is_board(p):\n    r, g, b = p\n    if abs(r-181) < 25 and abs(g-136) < 25 and abs(b-99) < 25:\n        return True\n    if abs(r-240) < 25 and abs(g-217) < 25 and abs(b-181) < 25:\n        return True\n    return False\n\ndef sig(r, c):\n    vals = []\n    for i in range(8, 72, 2):\n        for j in range(8, 72, 2):\n            p = im.getpixel((c*s + j, r*s + i))\n            if not is_board(p):\n                vals.append(sum(p))\n    vals.sort()\n    step = max(1, len(vals) // 64)\n    out = [sum(vals[k*step:(k+1)*step]) // step for k in range(64)]\n    return out\n\nexemplars = {}\nfor r, c, name in [(0,0,'k'),(0,2,'q'),(0,3,'r'),(0,5,'b'),(1,1,'n'),(1,5,'n'),(1,6,'r')]:\n    exemplars[name] = sig(r, c)\n\ndef show(r, c):\n    q = sig(r, c)\n    best = []\n    for name, e in exemplars.items():\n        d = sum(abs(a-b) for a, b in zip(q, e))\n        best.append((d, name))\n    best.sort()\n    print('abcdefgh'[c] + str(8-r), best[:3])\n\nfor r, c in [(0,4),(2,0),(2,2),(2,4),(3,3),(3,5),(3,6),(5,0),(5,2),(6,1),(6,4),(6,5),(6,6),(7,0),(7,2),(7,4),(7,7)]:\n    show(r, c)\nEOF\npython3 /app/classify.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
