nalg.norm(out[:m, None, :] - G.A1[None, :m, :], axis=2)\nra, ca = linear_sum_assignment(-D)\nprint('mean abs err on directions', np.mean(np.abs(out[:m][ra] - G.A1[ca])))\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
