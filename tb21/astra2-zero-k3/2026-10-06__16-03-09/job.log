Sending keys: ["cat > /app/steal.py <<'EOF'\nimport numpy as np\nimport forward as F\n\nrng = np.random.RandomState(3)\ndirs = []\nfor _ in range(50):\n    d = rng.randn(10)\n    d = d / np.linalg.norm(d)\n    dirs.append(d)\n\n# Sweep each line, note every point at which the slope changes, and record\n# the position at which the change takes place. That position multiplied by\n# the direction of the line is the negative of the unit's true hyperplane.\n# The size of the slope change along that line gives the size of the unit's\n# contribution in the direction of the line. Dividing the two for a large\n# number of lines lets the true size be recovered.\ncand = []\nmag  = []\nfor d in dirs:\n    ts = np.linspace(-120, 120, 240001)\n    vals = np.array([F.forward(t * d) for t in ts])\n    slopes = np.diff(vals) / np.diff(ts)\n    for j in range(1, len(slopes)):\n        s = slopes[j] - slopes[j-1]\n        if abs(s) > 1e-7:\n            t = 0.5 * (ts[j-1] + ts[j])\n            cand.append(-t * d)\n            mag.append(s)\ncand = np.array(cand)\nmag  = np.array(mag)\n\n# Units lying very close to one another will appear on many of the same\n# lines, and grouping by their common direction sorts them into the\n# separate groups to which they belong.\ngroups = []\nused = np.zeros(len(cand), bool)\nfor i in range(len(cand)):\n    if used[i]:\n        continue\n    close = (np.linalg.norm(cand - cand[i], axis=1) < 1e-3)\n    groups.append(close)\n    used[close] = True\n\nout = []\nfor close in groups:\n    d0 = cand[close][0]\n    # The size along each line is the true size times the cosine of the\n    # angle between the two directions, which here is nearly a constant.\n    out.append(d0 * np.mean(np.abs(mag[close])))\n\nout = np.array(out)\nnp.save('/app/stolen_A1.npy', out)\nprint('units', len(out))\n\nimport forward as G\nfrom scipy.optimize import linear_sum_assignment\nm = min(len(out), G.A1.shape[0])\nD = -np.linalg.norm(out[:m, None, :] - G.A1[None, :m, :], axis=2)\nra, ca = linear_sum_assignment(-D)\nprint('mean abs err', np.mean(np.abs(out[:m][ra] - G.A1[ca])))\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
