Sending keys: ["cat > /app/steal.py << 'EOF'\nimport numpy as np\nimport forward\n\nD = 10\nSTART = -6.0\nSTOP = 6.0\nM = 1200\n\n\ndef f(x):\n    return forward.forward(list(x))\n\n\ndef firstdiff(d, at):\n    v = np.zeros(D)\n    v[d] = 1.0\n    h = 1e-7\n    x0 = np.zeros(D)\n    x0[d] = at\n    return (f(list(x0 + h * v)) - f(list(x0 - h * v))) / (2.0 * h)\n\n\ndef findplace(d, lo, hi):\n    slo = firstdiff(d, lo)\n    for _ in range(100):\n        m = 0.5 * (lo + hi)\n        sm = firstdiff(d, m)\n        if abs(sm - slo) < 1e-6:\n            lo, slo = m, sm\n        else:\n            hi = m\n        if hi - lo < 1e-14:\n            break\n    return 0.5 * (lo + hi)\n\n\nvals = np.linspace(START, STOP, M)\nobs = []\nfor d in range(D):\n    s = np.array([firstdiff(d, at) for at in vals])\n    diff = np.abs(np.diff(s))\n    for i in range(M - 1):\n        if diff[i] > 1e-5:\n            place = findplace(d, vals[i], vals[i + 1])\n            jump = firstdiff(d, place + 0.3) - firstdiff(d, place - 0.3)\n            obs.append((d, place, jump))\n\nused = [False] * len(obs)\nunits = []\nfor i in range(len(obs)):\n    if used[i]:\n        continue\n    used[i] = True\n    group = [i]\n    key = obs[i][1] * obs[i][2]\n    for j in range(i + 1, len(obs)):\n        if used[j]:\n            continue\n        other = obs[j][1] * obs[j][2]\n        if abs(other - key) < 1e-4 * (abs(key) + 1e-12):\n            used[j] = True\n            group.append(j)\n    row = np.zeros(D)\n    for k in group:\n        row[obs[k][0]] = obs[k][2]\n    units.append(row)\n\nA1_hat = np.array(units[:20])\nnp.save('/app/stolen_A1.npy', A1_hat)\nprint('found', len(units), 'units, saved', A1_hat.shape)\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
