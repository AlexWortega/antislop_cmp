n.functional.mse_loss(out, tgt).item()\n        print(f'OK   norm={norm:5} nhead={nhead:2} act={act:4} nf={str(nf):5} -> out={tuple(out.shape)} mse={loss:.6f}')\n    except Exception as e:\n        print(f'FAIL norm={norm:5} nhead={nhead:2} act={act:4} nf={str(nf):5} -> {str(e)[:80]}')\nEOF\npython3 /tmp/exp.py 2>&1 | grep -v Warning\n"] min_timeout_sec: 60 max_timeout_sec: 180.0
