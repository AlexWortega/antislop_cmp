Sending keys: ['cat > /app/parallel_linear.py << \'EOF\'\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport torch.distributed as dist\n\n\nclass _GatherFromModelParallelRegion(torch.autograd.Function):\n    """Gather tensors from model parallel region and concatenate along last dim.\n    \n    Forward: all_gather + concat along last dimension\n    Backward: split gradient along last dimension, take local rank\'s slice\n    """\n    @staticmethod\n    def forward(ctx, input_):\n        world_size = dist.get_world_size()\n        rank = dist.get_rank()\n        if world_size == 1:\n            return input_\n        tensor_list = [torch.empty_like(input_) for _ in range(world_size)]\n        dist.all_gather(tensor_list, input_.contiguous())\n        ctx.rank = rank\n        ctx.world_size = world_size\n        output = torch.cat(tensor_list, dim=-1)\n        return output\n\n    @staticmethod\n    def backward(ctx, grad_output):\n        world_size = ctx.world_size\n        rank = ctx.rank\n        if world_size == 1:\n            return grad_output\n        chunk = grad_output.size(-1) // world_size\n        return grad_output.narrow(-1, rank * chunk, chunk).contiguous()\n\n\nclass _ReduceFromModelParallelRegion(torch.autograd.Function):\n    """Reduce (sum) tensors from model parallel region.\n    \n    Forward: all_reduce with SUM\n    Backward: identity (gradient passes through unchanged)\n    """\n    @staticmethod\n    def forward(ctx, input_):\n        world_size = dist.get_world_size()\n        if world_size == 1:\n            return input_\n        output = input_.clone()\n        dist.all_reduce(output, op=dist.ReduceOp.SUM)\n        return output\n\n    @staticmethod\n    def backward(ctx, grad_output):\n        return grad_output\n\n\nclass ColumnParallelLinear(nn.Module):\n    """Linear layer with column parallelism.\n    \n    The weight matrix [out_features, in_features] is split along dim 0 (out_features).\n    Each rank holds a slice of the output dimension.\n    The output is gathered (concatenated) along the last dimension.\n    The bias is sharded in the same way as the output dimension.\n    """\n    def __init__(self, in_features, out_features, bias, master_weight):\n        super().__init__()\n        self.in_features = in_features\n        self.out_features = out_features\n        \n        if dist.is_initialized():\n            self.world_size = dist.get_world_size()\n            self.rank = dist.get_rank()\n        else:\n            self.world_size = 1\n            self.rank = 0\n        \n        # Split weight along dim 0 (out_features dimension)\n        chunk = out_features // self.world_size\n        start = self.rank * chunk\n        end = start + chunk\n        \n        self.weight = nn.Parameter(master_weight[start:end, :].clone().detach())\n        \n        if bias:\n            self.bias = nn.Parameter(\n                torch.zeros(chunk, dtype=master_weight.dtype, device=master_weight.device)\n            )\n        else:\n            self.register_parameter(\'bias\', None)\n\n    def forward(self, input):\n        # Local linear computation: input @ W_r^T + b_r\n        output = F.linear(input, self.weight, self.bias)\n        # All-gather along last dimension to get full output\n        if self.world_size > 1:\n            output = _GatherFromModelParallelRegion.apply(output)\n        return output\n\n\nclass RowParallelLinear(nn.Module):\n    """Linear layer with row parallelism.\n    \n    The weight matrix [out_features, in_features] is split along dim 1 (in_features).\n    Each rank receives a pre-scattered slice of the input (partitioned along last dim).\n    The partial outputs are summed via all_reduce.\n    The bias remains full on each rank and is added after the all_reduce.\n    """\n    def __init__(self, in_features, out_features, bias, master_weight):\n        super().__init__()\n        self.in_features = in_features\n        self.out_features = out_features\n        \n        if dist.is_initialized():\n            self.world_size = dist.get_world_size()\n            self.rank = dist.get_rank()\n        else:\n            self.world_size = 1\n            self.rank = 0\n        \n        # Split weight along dim 1 (in_features dimension)\n        chunk = in_features // self.world_size\n        start = self.rank * chunk\n        end = start + chunk\n        \n        self.weight = nn.Parameter(master_weight[:, start:end].clone().detach())\n        \n        if bias:\n            self.bias = nn.Parameter(\n                torch.zeros(out_features, dtype=master_weight.dtype, device=master_weight.device)\n            )\n        else:\n            self.register_parameter(\'bias\', None)\n\n    def forward(self, input):\n        # input is already partitioned along last dimension\n        # Local linear computation without bias: input_r @ W_r^T\n        output = F.linear(input, self.weight)\n        # All-reduce (sum) the partial outputs\n        if self.world_size > 1:\n            output = _ReduceFromModelParallelRegion.apply(output)\n        # Add full bias after reduction\n        if self.bias is not None:\n            output = output + self.bias\n        return output\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
