Sending keys: ['cat > /app/steal.py << \'SCRIPT\'\nimport numpy as np\nimport sys\nsys.path.insert(0, \'/app\')\nimport forward\n\ndef f(x):\n    return forward.forward(np.array(x, dtype=np.float64))\n\ndef grad(x, eps=1e-7):\n    g = np.zeros(10)\n    for j in range(10):\n        xp = x.copy(); xp[j] += eps\n        xm = x.copy(); xm[j] -= eps\n        g[j] = (f(xp) - f(xm)) / (2.0 * eps)\n    return g\n\ndef main():\n    np.random.seed(42)\n    jumps = []\n    x0 = np.zeros(10)\n    n_lines = 200\n    t_range = 8.0\n    n_scan = 4000\n\n    for line_idx in range(n_lines):\n        v = np.random.randn(10)\n        v /= np.linalg.norm(v)\n\n        ts = np.linspace(-t_range, t_range, n_scan)\n        vals = np.empty(n_scan)\n        for i in range(n_scan):\n            vals[i] = f(x0 + ts[i] * v)\n\n        dt = ts[1] - ts[0]\n        slopes = np.diff(vals) / dt\n\n        for i in range(len(slopes) - 1):\n            if abs(slopes[i+1] - slopes[i]) > 1e-5:\n                t_star = ts[i+1]\n                delta = 0.01\n                x_before = x0 + (t_star - delta) * v\n                x_after = x0 + (t_star + delta) * v\n                g_before = grad(x_before)\n                g_after = grad(x_after)\n                jump = g_after - g_before\n                if np.linalg.norm(jump) > 1e-5:\n                    jumps.append(jump)\n\n        if (line_idx + 1) % 50 == 0:\n            print(f"Line {line_idx+1}/{n_lines}, jumps so far: {len(jumps)}")\n\n    print(f"Total jump events: {len(jumps)}")\n\n    # Cluster by direction (up to sign)\n    clusters = []\n    for j in jumps:\n        jn = np.linalg.norm(j)\n        if jn < 1e-10:\n            continue\n        j_dir = j / jn\n        found = False\n        for ci in range(len(clusters)):\n            ref = clusters[ci][0]\n            ref_dir = ref / np.linalg.norm(ref)\n            if abs(np.dot(j_dir, ref_dir)) > 0.999:\n                clusters[ci].append(j)\n                found = True\n                break\n        if not found:\n            clusters.append([j])\n\n    print(f"Total clusters: {len(clusters)}")\n\n    # Sort by size descending\n    clusters.sort(key=lambda c: len(c), reverse=True)\n    print("Top 30 clusters by size:")\n    for i, c in enumerate(clusters[:30]):\n        avg = np.mean(c, axis=0)\n        print(f"  Cluster {i}: {len(c):4d} jumps, norm={np.linalg.norm(avg):.6f}")\n\n    # Filter: keep clusters with size >= threshold\n    max_size = len(clusters[0])\n    threshold = max(30, int(0.1 * max_size))\n    real_clusters = [c for c in clusters if len(c) >= threshold]\n    print(f"\\nKeeping {len(real_clusters)} clusters (threshold={threshold})")\n\n    A1_rows = []\n    for ci, c in enumerate(real_clusters):\n        ref = c[0]\n        aligned = []\n        for j in c:\n            if np.dot(j, ref) < 0:\n                aligned.append(-j)\n            else:\n                aligned.append(j)\n        avg = np.mean(aligned, axis=0)\n        A1_rows.append(avg)\n        print(f"  Row {ci}: {len(c)} jumps, norm={np.linalg.norm(avg):.6f}")\n\n    A1_stolen = np.array(A1_rows)\n    np.save(\'/app/stolen_A1.npy\', A1_stolen)\n    print(f"\\nStolen A1 shape: {A1_stolen.shape}")\n    print("Saved to /app/stolen_A1.npy")\n\nif __name__ == \'__main__\':\n    main()\nSCRIPT\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
