gradients: PASS")\n    \n    # Row Parallel\n    row_linear = RowParallelLinear(in_features, out_features, bias=True, master_weight=master_weight.clone())\n    assert row_linear.weight.shape == (out_features, in_features), f"Row weight shape: {row_linear.weight.shape}"\n    assert row_linear.bias.shape == (out_features,), f"Row bias shape: {row_linear.bias.shape}"\n    assert torch.allclose(row_linear.weight, master_weight), "Row weight mismatch"\n    assert torch.allclose(row_linear.bias, torch.zeros(out_features)), "Row bias not zero"\n    \n    row_out = row_linear(input)\n    ref_out2 = ref_linear(input)\n    assert torch.allclose(row_out, ref_out2, atol=1e-5), f"Row output mismatch: {row_out} vs {ref_out2}"\n    print(f"  RowParallel forward: PASS")\n    \n    # Test gradients\n    row_out.sum().backward()\n    ref_out2.sum().backward()\n    assert torch.allclose(row_linear.weight.grad, ref_linear.weight.grad, atol=1e-5), "Row weight grad mismatch"\n    assert torch.allclose(row_linear.bias.grad, ref_linear.bias.grad, atol=1e-5), "Row bias grad mismatch"\n    print(f"  RowParallel gradients: PASS")\n    \n    print("  All single-process tests PASSED\\n")\n\n\ndef distributed_worker(rank, world_size, master_weight, input, port):\n    """Worker function for distributed testing."""\n    os.environ[\'MASTER_ADDR\'] = \'127.0.0.1\'\n    os.environ[\'MASTER_PORT\'] = str(port)\n    dist.init_process_group(\'gloo\', rank=rank, world_size=world_size)\n    \n    try:\n        in_features = master_weight.shape[1]\n        out_features = master_weight.shape[0]\n        \n        # Test ColumnParallelLinear\n        col_linear = ColumnParallelLinear(\n            in_features, out_features, bias=True,\n            master_weight=master_weight.clone()\n        )\n        \n        # Verify sharding\n        chunk_out = out_features // world_size\n        expected_w = master_weight[rank*chunk_out:(rank+1)*chunk_out, :]\n        assert col_linear.weight.shape == (chunk_out, in_features), \\\n            f"Rank {rank}: Col weight shape {col_linear.weight.shape}, expected ({chunk_out}, {in_features})"\n        assert torch.allclose(col_linear.weight, expected_w), f"Rank {rank}: Col weight value mismatch"\n        \n        expected_b = torch.zeros(chunk_out)\n        assert col_linear.bias.shape == (chunk_out,), \\\n            f"Rank {rank}: Col bias shape {col_linear.bias.shape}, expected ({chunk_out},)"\n        assert torch.allclose(col_linear.bias, expected_b), f"Rank {rank}: Col bias not zero"\n        \n        # Forward pass\n        col_out = col_linear(input)\n        assert col_out.shape == (input.shape[0], out_features), \\\n            f"Rank {rank}: Col output shape {col_out.shape}, expected ({input.shape[0]}, {out_features})"\n        \n        # Reference\n        ref_linear = nn.Linear(in_features, out_features, bias=True)\n        ref_linear.weight.data = master_weight.clone()\n        ref_linear.bias.data = torch.zeros(out_features)\n        ref_out = ref_linear(input)\n        \n        assert torch.allclose(col_out, ref_out, atol=1e-5), \\\n            f"Rank {rank}: Col output mismatch\\nGot: {col_out}\\nExpected: {ref_out}"\n        \n        # Gradients\n        col_out.sum().backward()\n        ref_out.sum().backward()\n        assert torch.allclose(col_linear.weight.grad, ref_linear.weight.grad, atol=1e-5), \\\n            f"Rank {rank}: Col weight grad mismatch"\n        assert torch.allclose(col_linear.bias.grad, ref_linear.bias.grad, atol=1e-5), \\\n            f"Rank {rank}: Col bias grad mismatch"\n        \n        # Test RowParallelLinear\n        row_linear = RowParallelLinear(\n            in_features, out_features, bias=True,\n            master_weight=master_weight.clone()\n        )\n        \n        # Verify sharding\n        chunk_in = in_features // world_size\n        expected_rw = master_weight[:, rank*chunk_in:(rank+1)*chunk_in]\n        assert row_linear.weight.shape == (out_features, chunk_in), \\\n            f"Rank {rank}: Row weight shape {row_linear.weight.shape}, expected ({out_features}, {chunk_in})"\n        assert torch.allclose(row_linear.weight, expected_rw), f"Rank {rank}: Row weight value mismatch"\n        \n        expected_rb = torch.zeros(out_features)\n        assert row_linear.bias.shape == (out_features,), \\\n            f"Rank {rank}: Row bias shape {row_linear.bias.shape}, expected ({out_features},)"\n        assert torch.allclose(row_linear.bias, expected_rb), f"Rank {rank}: Row bias not zero"\n        \n        # Forward pass - input is pre-scattered along last dim\n        input_scattered = input[:, rank*chunk_in:(rank+1)*chunk_in]\n        row_out = row_linear(input_scattered)\n        assert row_out.shape == (input.shape[0], out_features), \\\n            f"Rank {rank}: Row output shape {row_out.shape}, expected ({input.shape[0]}, {out_features})"\n        \n        assert torch.allclose(row_out, ref_out, atol=1e-5), \\\n            f"Rank {rank}: Row output mismatch\\nGot: {row_out}\\nExpected: {ref_out}"\n        \n        # Gradients\n        row_out.sum().backward()\n        ref_out.sum().backward()\n        assert torch.allclose(row_linear.weight.grad, ref_linear.weight.grad, atol=1e-5), \\\n            f"Rank {rank}: Row weight grad mismatch"\n        assert torch.allclose(row_linear.bias.grad, ref_linear.bias.grad, atol=1e-5), \\\n            f"Rank {rank}: Row bias grad mismatch"\n        \n        # Test without bias\n        col_linear_nb = ColumnParallelLinear(\n            in_features, out_features, bias=False,\n            master_weight=master_weight.clone()\n        )\n        assert col_linear_nb.bias is None\n        assert col_linear_nb.weight.shape == (chunk_out, in_features)\n        \n        row_linear_nb = RowParallelLinear(\n            in_features, out_features, bias=False,\n            master_weight=master_weight.clone()\n        )\n        assert row_linear_nb.bias is None\n        assert row_linear_nb.weight.shape == (out_features, chunk_in)\n        \n        if rank == 0:\n            print(f"  world_size={world_size}: All distributed tests PASSED")\n    \n    finally:\n        dist.destroy_process_group()\n\n\ndef test_distributed(world_size, port):\n    """Run distributed test with given world_size."""\n    print(f"=== Testing distributed (world_size={world_size}) ===")\n    \n    torch.manual_seed(42)\n    in_features = 8\n    out_features = 4\n    master_weight = torch.randn(out_features, in_features)\n    input = torch.randn(3, in_features)\n    \n    mp.start_processes(\n        distributed_worker,\n        args=(world_size, master_weight, input, port),\n        nprocs=world_size,\n        join=True,\n        start_method=\'spawn\'\n    )\n    print()\n\n\ndef main():\n    test_single_process()\n    test_distributed(2, 29500)\n    test_distributed(4, 29501)\n    print("All tests PASSED!")\n\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
